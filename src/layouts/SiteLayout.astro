---
import SiteHead from "../components/SiteHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNavbar from "../components/SiteNavbar.astro";

interface Props {
	title: string;
	description?: string;
}

const { title = "MisterDatos | Sitio Web Oficial", description } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<SiteHead title={title} description={description} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<SiteNavbar />
		</header>
		<a class="skip-link" href="#main-content">Saltar al contenido</a>
		<main id="main-content">
			<slot />
		</main>
		<SiteFooter />
		<style is:global>
			:root {
				color-scheme: dark;
				--color-primary: #a588ff;
				--color-primary-soft: #c6b5ff;
				--color-dark: #341b39;
				--color-accent: #a588ff;
				--color-white: #ffffff;
				--surface-page: #1b1220;
				--surface-panel: #24172a;
				--surface-raised: #2d1d35;
				--font-body: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
					sans-serif;
				--home-content-max: 1200px;
				--home-page-gutter: clamp(1rem, 4vw, 2rem);
				--home-section-space: clamp(1.25rem, 4vw, 2.5rem);
				--home-content-gap: clamp(0.75rem, 2vw, 1.25rem);
				--transition: all 0.25s ease;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
				overflow-y: scroll;
				overflow-x: hidden;
				scrollbar-gutter: stable;
				scroll-padding-top: 5rem;
			}

			body {
				min-width: 320px;
				background:
					radial-gradient(ellipse at 50% -18rem, rgb(165 136 255 / 12%), transparent 48rem),
					var(--surface-page);
				font-family: var(--font-body);
				color: var(--color-white);
				overflow-x: hidden;
				line-height: 1.5;
			}

			header {
				width: 100%;
				z-index: 1000;
			}

			main {
				min-height: 60vh;
			}

			.skip-link {
				position: fixed;
				top: 0.75rem;
				left: 0.75rem;
				z-index: 2000;
				padding: 0.75rem 1rem;
				border: 1px solid var(--color-primary-soft);
				border-radius: 0.75rem;
				background: var(--surface-raised);
				color: #fff;
				font: 600 0.9rem/1.3 var(--font-body);
				text-decoration: none;
				transform: translateY(-160%);
			}

			.skip-link:focus {
				transform: translateY(0);
			}

			:focus-visible {
				scroll-margin-block: 6rem;
			}

			::selection {
				background: rgb(165 136 255 / 55%);
				color: #fff;
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}
			}
		</style>
	</body>
</html>
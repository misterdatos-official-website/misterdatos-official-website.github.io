---
import SiteHead from "../components/SiteHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNavbar from "../components/SiteNavbar.astro";

interface Props {
	title: string;
}

const { title = "MisterDatos | Sitio Web Oficial" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<SiteHead />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<SiteNavbar />
		</header>
		<main>
			<slot />
		</main>
		<SiteFooter />
		<style is:global>
			:root {
				--color-primary: #a588ff;
				--color-dark: #341B39;
				--color-accent: #a588ff;
				--color-white: #ffffff;
				--surface-page: #1b1220;
				--surface-panel: #24172a;
				--surface-raised: #2d1d35;
				--home-content-max: 1200px;
				--home-page-gutter: clamp(1rem, 4vw, 2rem);
				--home-section-space: clamp(1.25rem, 4vw, 2.5rem);
				--home-content-gap: clamp(0.75rem, 2vw, 1.25rem);
				--font-main: "Michroma", sans-serif;
				--transition: all 0.5s cubic-bezier(0.25, 0.1, 0.25, 1);
			}
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}
			html {
				scroll-behavior: smooth;
				overflow-y: scroll;
				overflow-x: hidden;
				scrollbar-gutter: stable;
			}
			body {
				background-color: var(--surface-page);
				font-family: var(--font-main);
				color: var(--color-white);
				overflow-x: hidden;
			}
			header {
				width: 100%;
				z-index: 1000;
			}
		</style>
	</body>
</html>
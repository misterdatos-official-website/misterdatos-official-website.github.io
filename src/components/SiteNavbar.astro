---
import misterlogo from "../assets/misterlogo.svg";
import { Image } from "astro:assets";

const currentPath = Astro.url.pathname;
---

<nav class="navbar" aria-label="Navegación principal" data-menu-open="false">
  <div class="navbar-inner">
    <a class="logo" href="/" aria-label="MisterDatos, inicio">
      <Image src={misterlogo} alt="MisterDatos" loading="eager" />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="primary-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <button
      class="nav-backdrop"
      type="button"
      aria-label="Cerrar menú"
      tabindex="-1"
    ></button>

    <div class="nav-panel" id="primary-navigation">
      <ul class="nav-links">
        <li>
          <a
            href="/"
            aria-current={currentPath === "/" ? "page" : undefined}
          >Inicio</a>
        </li>
        <li>
          <a
            href="/blog"
            aria-current={currentPath.startsWith("/blog") ? "page" : undefined}
          >Blog</a>
        </li>
      </ul>

    </div>
  </div>
</nav>

<style>
  .navbar {
    --header-height: 78px;
    position: relative;
    top: 0;
    z-index: 1000;
    height: var(--header-height);
    border-bottom: 1px solid rgb(255 255 255 / 9%);
    background: transparent;
  }

  .navbar::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(36 23 42 / 92%);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    content: "";
  }

  .navbar-inner {
    width: min(100% - 2.5rem, 1240px);
    height: 100%;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo {
    display: flex;
    flex: 0 1 auto;
    align-items: center;
    text-decoration: none;
  }

  .logo img {
    display: block;
    width: clamp(145px, 19vw, 205px);
    height: auto;
    object-fit: contain;
  }

  .nav-panel {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 2;
    width: min(75vw, 360px);
    height: 100vh;
    height: 100dvh;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    background: var(--surface-raised);
    border-left: 1px solid rgb(165 136 255 / 20%);
    box-shadow: -20px 24px 50px rgb(0 0 0 / 24%);
    overscroll-behavior: contain;
    transform: translateX(105%);
    visibility: hidden;
    transition:
      transform 240ms ease,
      visibility 240ms;
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
  }

  .nav-links a {
    position: relative;
    display: block;
    padding: 0.75rem;
    color: rgb(255 255 255 / 78%);
    font: 600 1.25rem/1.4 system-ui, sans-serif;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    color: #fff;
  }

  .nav-links a[aria-current="page"]::before {
    position: absolute;
    top: 50%;
    left: -0.25rem;
    width: 3px;
    height: 1.25rem;
    border-radius: 3px;
    background: var(--color-primary);
    content: "";
    transform: translateY(-50%);
  }

  .menu-toggle {
    position: relative;
    z-index: 3;
    width: 44px;
    height: 44px;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 12px;
    background: rgb(255 255 255 / 5%);
    cursor: pointer;
  }

  .menu-toggle span {
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: #fff;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1;
    border: 0;
    background: rgb(10 5 15 / 65%);
    overscroll-behavior: contain;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 240ms ease,
      visibility 240ms;
  }

  .navbar[data-menu-open="true"] .nav-panel {
    transform: translateX(0);
    visibility: visible;
  }

  .navbar[data-menu-open="true"] .nav-backdrop {
    opacity: 1;
    visibility: visible;
  }

  .navbar[data-menu-open="true"] .menu-toggle span:first-child {
    transform: translateY(9px) rotate(45deg);
  }

  .navbar[data-menu-open="true"] .menu-toggle span:nth-child(2) {
    opacity: 0;
  }

  .navbar[data-menu-open="true"] .menu-toggle span:last-child {
    transform: translateY(-9px) rotate(-45deg);
  }

  .menu-toggle:focus-visible,
  .nav-links a:focus-visible {
    outline: 2px solid #c6b5ff;
    outline-offset: 4px;
  }

  @media (min-width: 768px) {
    .navbar {
      position: sticky;
    }

    .navbar-inner {
      width: min(100% - 4rem, 1240px);
    }

    .menu-toggle,
    .nav-backdrop {
      display: none;
    }

    .nav-panel {
      position: static;
      width: auto;
      height: auto;
      padding: 0;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: clamp(1.5rem, 4vw, 3.5rem);
      border: 0;
      background: transparent;
      box-shadow: none;
      transform: none;
      visibility: visible;
    }

    .nav-links {
      flex-direction: row;
      align-items: center;
      gap: clamp(1rem, 2.5vw, 2.5rem);
    }

    .nav-links a {
      padding: 0.7rem 0;
      font-size: 0.92rem;
      letter-spacing: normal;
    }

    .nav-links a[aria-current="page"]::before {
      top: auto;
      bottom: 0;
      left: 50%;
      width: 1.2rem;
      height: 2px;
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-panel,
    .nav-backdrop,
    .menu-toggle span,
    .nav-links a {
      transition: none;
    }
  }
</style>

<script>
  const navbar = document.querySelector<HTMLElement>(".navbar");
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navBackdrop = document.querySelector<HTMLButtonElement>(".nav-backdrop");
  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-links a");
  let previousHtmlOverflowY: string | null = null;
  let previousBodyOverflow: string | null = null;

  const setMenuOpen = (isOpen: boolean) => {
    if (!navbar || !menuToggle) return;

    const wasOpen = navbar.dataset.menuOpen === "true";
    if (isOpen && !wasOpen) {
      previousHtmlOverflowY = document.documentElement.style.overflowY;
      previousBodyOverflow = document.body.style.overflow;
      document.documentElement.style.overflowY = "hidden";
      document.body.style.overflow = "hidden";
    } else if (!isOpen && wasOpen) {
      document.documentElement.style.overflowY = previousHtmlOverflowY ?? "";
      document.body.style.overflow = previousBodyOverflow ?? "";
      previousHtmlOverflowY = null;
      previousBodyOverflow = null;
    }

    navbar.dataset.menuOpen = String(isOpen);
    menuToggle.setAttribute("aria-expanded", String(isOpen));
    menuToggle.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
  };

  menuToggle?.addEventListener("click", () => {
    setMenuOpen(navbar?.dataset.menuOpen !== "true");
  });

  navBackdrop?.addEventListener("click", () => setMenuOpen(false));

  navLinks.forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  window.matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
    if (event.matches) setMenuOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && navbar?.dataset.menuOpen === "true") {
      setMenuOpen(false);
      menuToggle?.focus();
    }
  });
</script>

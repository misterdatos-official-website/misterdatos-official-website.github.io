---
import { Image } from "astro:assets";
import misterdatosweb from "../assets/misterdatosweb.webp";
import misterdatosweb2 from "../assets/misterdatosweb2.webp";

const projects = [
  {
    title: "Stream en Twitch",
    subtitle: "Acompáñanos los viernes y sabados a las 9:00 PM Hora México.",
    image: misterdatosweb,
    link: "https://www.twitch.tv/misterdatos",
  },
  {
    title: "¡Nuevo canal de YouTube!",
    subtitle: "Visita mi nuevo canal dedicado a mi música.",
    image: misterdatosweb2,
    link: "https://www.youtube.com/@misterdatos_oficial",
  },
];
---

<div class="slider-container">
  <div id="main-display" class="main-display">
    {
      projects.map((project, index) => (
        <a
          href={project.link}
          target="_blank"
          rel="noopener"
          class={`slide ${index === 0 ? "active" : ""}`}
          data-index={index}
          aria-labelledby={`project-title-${index}`}
          inert={index !== 0}
        >
          <Image
            src={project.image}
            alt=""
            width={project.image.width}
            height={project.image.height}
            loading="eager"
            fetchpriority={index === 0 ? "high" : "auto"}
            quality={100}
          />
          <div class="info">
            <h2 id={`project-title-${index}`}>{project.title}</h2>
            <p>{project.subtitle}</p>
          </div>
        </a>
      ))
    }
  </div>

  <div class="controls-overlay">
    <button id="pause-btn" class="control-icon" aria-label="Pausar presentación"
    ></button>

    <div class="thumbnails">
      {
        projects.map((project, index) => (
          <button
            class={`thumb-btn ${index === 0 ? "selected" : ""}`}
            data-index={index}
            aria-label={`Mostrar: ${project.title}`}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            <Image
              src={project.image}
              alt=""
              width={50}
              height={50}
              loading="eager"
              quality={100}
            />
          </button>
        ))
      }
    </div>
  </div>
</div>

<style>
  .slider-container {
    --controls-height: clamp(4.5rem, 8vw, 5rem);
    width: 100%;
    background: var(--surface-page);
    color: var(--color-white);
    font-family: sans-serif;
    overflow: hidden;
    position: relative;
    -webkit-tap-highlight-color: transparent;
  }

  .main-display {
    position: relative;
    height: clamp(280px, 42vw, 420px);
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
    text-decoration: none;
    color: #ffffff;
    outline: none;
  }

  .slide.active {
    opacity: 1;
    z-index: 1;
  }

  .slide:active {
    opacity: 0.9;
    filter: brightness(0.8);
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info {
    position: absolute;
    bottom: var(--controls-height);
    left: 0;
    right: 0;
    padding: clamp(2.5rem, 8vw, 3.75rem) var(--home-page-gutter)
      var(--home-content-gap);
    z-index: 2;
    background: linear-gradient(
      to top,
      #000000e0 0%,
      transparent 100%
    );
  }

  .info h2 {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.8rem);
  }
  .info p {
    margin: 0.35rem 0 0;
    font-size: clamp(0.85rem, 1.8vw, 1rem);
    opacity: 0.8;
  }

  .controls-overlay {
    display: flex;
    min-height: var(--controls-height);
    align-items: center;
    justify-content: center;
    gap: var(--home-content-gap);
    padding: var(--home-content-gap) var(--home-page-gutter);
    position: absolute;
    bottom: 0;
    width: 100%;
    z-index: 10;
    background: #000000e0;
    backdrop-filter: blur(5px);
  }

  .control-icon {
    width: 46px;
    height: 46px;
    border: 2px solid var(--color-accent);
    background: var(--surface-raised);
    cursor: pointer;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: all 0.3s ease;
    padding: 0px;
    outline: none;
  }

  .control-icon:active {
    transform: scale(0.9);
    border-color: #a588ff;
    box-shadow: 0 0 10px #a588ff;
  }

  .control-icon::before,
  .control-icon::after {
    content: "";
    position: absolute;
    width: 4px;
    height: 16px;
    background-color: var(--color-accent);
    transition: all 0.3s ease;
  }

  .control-icon::before {
    transform: translateX(-4px);
  }
  .control-icon::after {
    transform: translateX(4px);
  }

  .control-icon:hover {
    border-color: var(--color-white);
    box-shadow: 0 0 10px var(--color-purple);
  }

  .control-icon.is-paused::before {
    height: 20px;
    width: 20px;
    background-color: var(--color-accent);
    clip-path: polygon(20% 0%, 20% 100%, 100% 50%);
    transform: translateX(2px);
  }

  .control-icon.is-paused::after {
    opacity: 0;
  }

  .thumbnails {
    display: flex;
    gap: clamp(0.5rem, 1.5vw, 0.75rem);
  }

  .thumb-btn {
    width: clamp(2.5rem, 7vw, 3.125rem);
    height: clamp(2.5rem, 7vw, 3.125rem);
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
    background: #ffffff25;
    padding: 0;
    outline: none;
  }

  .thumb-btn:active {
    border-color: #a588ff;
    transform: scale(0.95);
  }

  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .thumb-btn.selected {
    border-color: var(--color-primary);
    transform: scale(1.1);
  }

  .thumb-btn.selected img {
    opacity: 1;
  }
</style>

<script>
  const setupSlider = () => {
    let currentIndex: number = 0;
    let isPaused: boolean = false;
    let slideInterval: number | undefined;

    const slides = document.querySelectorAll(".slide");
    const thumbs = document.querySelectorAll(".thumb-btn");
    const pauseBtn = document.getElementById("pause-btn");
    const totalSlides = slides.length;

    if (!pauseBtn || totalSlides === 0) return;

    function showSlide(index: number) {
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === index;
        slide.classList.toggle("active", isActive);
        slide.toggleAttribute("inert", !isActive);
      });
      thumbs.forEach((thumb, thumbIndex) => {
        const isSelected = thumbIndex === index;
        thumb.classList.toggle("selected", isSelected);
        thumb.setAttribute("aria-pressed", String(isSelected));
      });

      currentIndex = index;
    }

    function nextSlide() {
      if (!isPaused) {
        let next = (currentIndex + 1) % totalSlides;
        showSlide(next);
      }
    }

    function startSlideShow() {
      if (slideInterval) clearInterval(slideInterval);
      slideInterval = window.setInterval(nextSlide, 5000);
    }

    function stopSlideShow() {
      if (slideInterval) {
        clearInterval(slideInterval);
        slideInterval = undefined;
      }
    }

    startSlideShow();

    thumbs.forEach((btn) => {
      btn.addEventListener("click", () => {
        const htmlBtn = btn as HTMLButtonElement;
        const index = parseInt(htmlBtn.getAttribute("data-index") || "0");
        showSlide(index);
        if (!isPaused) startSlideShow();
      });
    });

    pauseBtn.addEventListener("click", () => {
      isPaused = !isPaused;
      pauseBtn.classList.toggle("is-paused", isPaused);
      pauseBtn.setAttribute(
        "aria-label",
        isPaused ? "Reanudar presentación" : "Pausar presentación",
      );
      if (isPaused) stopSlideShow();
      else startSlideShow();
    });
  };

  setupSlider();
  document.addEventListener("astro:after-swap", setupSlider);
</script>
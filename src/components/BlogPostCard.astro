---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  url: string;
  date: Date;
  image?: ImageMetadata;
  category?: string;
  slug?: string;
}

const { title, description, url, date, image, category, slug } = Astro.props;
const formattedDate = date.toLocaleDateString("es-ES", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<article
  class="blog-card"
  data-title={title.toLowerCase()}
  data-description={description.toLowerCase()}
  data-post-slug={slug}
>
  <a href={url} class="card-link" aria-label={`Leer ${title}`}>
    {
      image && (
        <div class="image-wrapper">
          <Image
            src={image}
            alt=""
            loading="lazy"
            decoding="async"
            format="png"
          />
        </div>
      )
    }

    <div class="text-wrapper">
      <div class="post-meta">
        <time class="post-date" datetime={date.toISOString()}>{formattedDate}</time>
        {category && <span class="category">{category}</span>}
      </div>
      <h2 class="post-title">{title}</h2>
      <p class="post-description">{description}</p>
      <span class="read-more">
        Leer artículo
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M4 10h12m-5-5 5 5-5 5" />
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .blog-card {
    width: 100%;
    overflow: hidden;
    border: 1px solid rgb(165 136 255 / 28%);
    border-radius: 1.25rem;
    background: #221425;
    box-shadow: 0 10px 30px rgb(0 0 0 / 14%);
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
  }

  .blog-card:hover {
    transform: translateY(-5px);
    border-color: rgb(165 136 255 / 75%);
    box-shadow: 0 18px 40px rgb(0 0 0 / 25%);
  }

  .card-link {
    display: flex;
    height: 100%;
    flex-direction: column;
    color: #fff;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .card-link:focus-visible {
    outline: 3px solid #a588ff;
    outline-offset: 4px;
    border-radius: 1.25rem;
  }

  .image-wrapper {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #341b39;
  }

  .image-wrapper::after {
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(transparent, rgb(34 20 37 / 25%));
    content: "";
    pointer-events: none;
  }

  .image-wrapper :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.2, 0.65, 0.3, 1);
  }

  .blog-card:hover .image-wrapper :global(img) {
    transform: scale(1.045);
  }

  .text-wrapper {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .post-meta {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .post-date {
    color: #c6b5ff;
    font: 500 0.8rem/1.4 system-ui, sans-serif;
  }

  .category {
    padding: 0.35rem 0.7rem;
    border: 1px solid rgb(165 136 255 / 38%);
    border-radius: 999px;
    background: rgb(165 136 255 / 12%);
    color: #e0d7ff;
    font: 700 0.68rem/1 system-ui, sans-serif;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .post-title {
    margin: 0 0 0.75rem;
    color: #fff;
    font: 700 clamp(1.25rem, 2.5vw, 1.55rem)/1.25 system-ui, sans-serif;
    text-wrap: balance;
  }

  .post-description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0 0 1.5rem;
    color: rgb(255 255 255 / 74%);
    font: 400 0.95rem/1.65 system-ui, sans-serif;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: auto;
    color: #c6b5ff;
    font: 700 0.9rem/1.4 system-ui, sans-serif;
  }

  .read-more svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
    transition: transform 180ms ease;
  }

  .blog-card:hover .read-more svg {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card,
    .image-wrapper :global(img),
    .read-more svg {
      transition: none;
    }
  }
</style>

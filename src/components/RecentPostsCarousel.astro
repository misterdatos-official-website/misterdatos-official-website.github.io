---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const allPosts = await getCollection("blog");

const recentPosts = allPosts
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<section class="blog-section" id="blog">
    <div class="blog-header">
        <h2 class="section-title">Últimas Novedades</h2>
        <div class="slider-controls">
            <button id="prevBtn" class="control-btn" aria-label="Anterior"
                >❮</button
            >
            <button id="nextBtn" class="control-btn" aria-label="Siguiente"
                >❯</button
            >
        </div>
    </div>

    <div class="scroll-container" id="slider">
        <div class="posts-slider">
            {
                recentPosts.map((post) => (
                    <a
                        href={`/blog/${post.slug}`}
                        class="post-card-link"
                        aria-label={`Leer artículo: ${post.data.title}`}
                    >
                        <article class="post-card">
                            {post.data.image && (
                                <div class="post-image">
                                    <Image
                                        src={post.data.image}
                                        alt={post.data.title}
                                        loading={"lazy"}
                                        decoding={"async"}
                                        format="png"
                                        quality={100}
                                    />
                                    <h3 class="post-title">{post.data.title}</h3>
                                </div>
                            )}
                            {!post.data.image && (
                                <h3 class="post-title">{post.data.title}</h3>
                            )}
                            <span class="read-article">
                                Leer artículo
                                <svg viewBox="0 0 20 20" aria-hidden="true">
                                    <path d="M4 10h12m-5-5 5 5-5 5" />
                                </svg>
                            </span>
                        </article>
                    </a>
                ))
            }
        </div>
    </div>

    <div class="view-all-container">
        <a href="/blog" class="btn-all">
            <span>Ver todas las publicaciones</span>
            <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12m-5-5 5 5-5 5" />
            </svg>
        </a>
    </div>
</section>

<script>
    const slider = document.getElementById("slider");
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");

    if (slider && prevBtn && nextBtn) {
        nextBtn.addEventListener("click", () => {
            slider.scrollBy({ left: 350, behavior: "smooth" });
        });
        prevBtn.addEventListener("click", () => {
            slider.scrollBy({ left: -350, behavior: "smooth" });
        });
    }
</script>

<style>
    .blog-section {
        width: min(100%, var(--home-content-max));
        padding: var(--home-section-space) var(--home-page-gutter);
        margin-inline: auto;
        color: #ffffff;
        background-color: var(--surface-page);
        scroll-margin-top: 80px;
    }

    .blog-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .section-title {
        font-size: 1.25rem;
        margin: 0;
        color: #ffffff;
    }

    .slider-controls {
        display: none;
        gap: 0.5rem;
    }

    .control-btn {
        background: var(--surface-raised);
        border: 1px solid #a588ff;
        color: #a588ff;
        padding: 0.5rem 0.8rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        -webkit-tap-highlight-color: transparent;
        outline: none;
    }

    .control-btn:hover {
        background: var(--surface-raised);
        color: #ffffff;
    }

    .scroll-container {
        width: 100%;
        overflow-x: auto;
        scroll-behavior: smooth;
        scrollbar-width: none;
        -ms-overflow-style: none;
        padding: 1rem 0 1rem 0;
    }

    .scroll-container::-webkit-scrollbar {
        display: none;
    }

    .posts-slider {
        display: flex;
        gap: var(--home-content-gap);
    }

    .post-card-link {
        text-decoration: none;
        flex: 0 0 calc((100% - var(--home-content-gap)) / 2);
        display: flex;
        -webkit-tap-highlight-color: transparent;
        outline: none;
    }

    .post-card {
        --card-content-inset: 1rem;
        position: relative;
        display: block;
        width: 100%;
        min-height: clamp(210px, 62vw, 280px);
        isolation: isolate;
        background: var(--surface-raised);
        border-radius: 15px;
        overflow: hidden;
        border: 1px solid #a588ff;
        transition:
            transform 0.3s ease,
            border-color 0.3s ease,
            filter 0.2s ease,
            box-shadow 0.3s ease;
        height: 100%;
    }

    .post-card:active {
        transform: scale(0.97);
        border-color: #a588ff;
        filter: brightness(0.8);
    }

    .post-card:hover {
        transform: translateY(-5px);
    }

    .post-image img {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        background: #170f1a;
    }

    .post-image {
        position: absolute;
        inset: 0;
        isolation: isolate;
        z-index: -1;
    }

    .post-image::after {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            180deg,
            rgb(0 0 0 / 4%) 20%,
            rgb(0 0 0 / 24%) 48%,
            rgb(0 0 0 / 82%) 100%
        );
        content: "";
        pointer-events: none;
    }

    .post-title {
        margin: 0;
        padding: 1rem var(--card-content-inset);
        color: #ffffff;
        font-size: 1.15rem;
        line-height: 1.3;
    }

    .post-image .post-title {
        position: absolute;
        right: var(--card-content-inset);
        bottom: calc(var(--card-content-inset) + 3.5rem);
        left: var(--card-content-inset);
        z-index: 1;
        padding: 0;
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        text-shadow: 0 1px 4px rgb(0 0 0 / 75%);
    }

    .post-card > .post-title {
        position: relative;
        z-index: 1;
        padding: var(--card-content-inset);
        color: #fff;
    }

    .read-article {
        min-height: 2.75rem;
        position: absolute;
        right: var(--card-content-inset);
        bottom: var(--card-content-inset);
        left: var(--card-content-inset);
        z-index: 2;
        margin: 0;
        padding: 0.65rem 0.9rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        border: 1px solid rgb(165 136 255 / 58%);
        border-radius: 0.75rem;
        background: rgb(165 136 255 / 10%);
        color: #e0d7ff;
        font: 700 0.9rem/1.2 system-ui, sans-serif;
        transition:
            border-color 180ms ease,
            background-color 180ms ease,
            color 180ms ease;
    }

    .read-article svg {
        width: 1rem;
        height: 1rem;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.8;
        transition: transform 180ms ease;
    }

    .post-card-link:hover .read-article {
        border-color: #a588ff;
        background: rgb(165 136 255 / 20%);
        color: #fff;
    }

    .post-card-link:hover .read-article svg {
        transform: translateX(3px);
    }

    .view-all-container {
        display: flex;
        justify-content: center;
        padding-top: var(--home-content-gap);
    }

    .btn-all {
        min-height: 3.25rem;
        padding: 0.85rem 1.35rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        border: 1px solid rgb(165 136 255 / 58%);
        border-radius: 999px;
        background: rgb(165 136 255 / 10%);
        color: #e0d7ff;
        font: 700 0.95rem/1.2 system-ui, sans-serif;
        text-decoration: none;
        transition:
            transform 180ms ease,
            border-color 180ms ease,
            background-color 180ms ease,
            box-shadow 180ms ease,
            color 180ms ease;
        -webkit-tap-highlight-color: transparent;
    }

    .btn-all:hover {
        transform: translateY(-2px);
        border-color: #a588ff;
        background: rgb(165 136 255 / 20%);
        box-shadow: 0 8px 24px rgb(0 0 0 / 22%);
        color: #fff;
    }

    .btn-all:focus-visible {
        outline: 2px solid #c6b5ff;
        outline-offset: 4px;
    }

    .btn-all svg {
        width: 1.1rem;
        height: 1.1rem;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.8;
        transition: transform 180ms ease;
    }

    .btn-all:hover svg {
        transform: translateX(3px);
    }

    .btn-all:active {
        transform: translateY(0);
        background: rgb(165 136 255 / 28%);
    }

    @media (prefers-reduced-motion: reduce) {
        .btn-all,
        .btn-all svg,
        .read-article,
        .read-article svg {
            transition: none;
        }
    }

    @media (min-width: 768px) {
        .slider-controls {
            display: flex;
        }
        .post-card-link {
            flex-basis: 320px;
        }
        .post-card {
            min-height: 320px;
        }
    }
</style>
---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const publishDate = entry.data.date.toLocaleDateString("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const youtubeVideoId = entry.data.youtubeId;
---

<SiteLayout title={entry.data.title}>
  <article class="post-container">
    <header class="post-header">
      <a class="back-link" href="/blog">
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M16 10H4m5 5-5-5 5-5" />
        </svg>
        Volver al blog
      </a>
      <h1 class="post-title">{entry.data.title}</h1>

      <div class="post-meta">
        <span class="meta-item">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"
              ></rect><line x1="16" y1="2" x2="16" y2="6"></line><line
                x1="8"
                y1="2"
                x2="8"
                y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg
            >
            {publishDate}
        </span>
        <div class="author-details">
          <span class="meta-item">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"
              ></path><circle cx="12" cy="7" r="4"></circle></svg
            >
            {entry.data.author || "MisterDatos"}
          </span>
          <span class="category-badge">{entry.data.categories?.[0] || "General"}</span>
        </div>
      </div>

      {
        entry.data.image && (
          <div class="image-wrapper">
            <Image
              src={entry.data.image}
              alt={entry.data.title}
              class="featured-image"
              loading="eager"
              fetchpriority="high"
              widths={[640, 960, 1280]}
              sizes="(max-width: 900px) calc(100vw - 2rem), 860px"
              quality={100}
            />
          </div>
        )
      }
    </header>

    <div class="article-body">
      <section class="prose">
        <Content />
      </section>

      {
        youtubeVideoId && (
          <section class="video-section">
            <h2 class="section-title">Video Relacionado</h2>
            <div class="video-responsive">
              <iframe
                src={`https://www.youtube.com/embed/${youtubeVideoId}`}
                title="YouTube video player"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              />
            </div>
          </section>
        )
      }
    </div>
  </article>
</SiteLayout>

<style>
  .post-container {
    width: min(100% - 2rem, 860px);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) 0 5rem;
  }

  .post-header {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .back-link {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
    color: rgb(255 255 255 / 68%);
    font: 600 0.88rem/1.4 system-ui, sans-serif;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .back-link:hover {
    color: #c6b5ff;
  }

  .back-link:focus-visible,
  .prose :global(a:focus-visible) {
    outline: 2px solid #c6b5ff;
    outline-offset: 4px;
    border-radius: 3px;
  }

  .back-link svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .post-title {
    max-width: 780px;
    margin: 0.8rem 0 1.25rem;
    color: #fff;
    font: 700 clamp(2rem, 6vw, 3.5rem)/1.12 system-ui, sans-serif;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.75rem;
    color: rgb(255 255 255 / 68%);
    font: 500 0.9rem/1.5 system-ui, sans-serif;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .author-details {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .meta-item svg {
    flex: 0 0 auto;
    color: #c6b5ff;
  }

  .image-wrapper {
    overflow: hidden;
    border: 1px solid rgb(165 136 255 / 20%);
    border-radius: 1.25rem;
    background: var(--surface-panel);
    box-shadow: 0 18px 45px rgb(0 0 0 / 22%);
  }

  .featured-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .article-body {
    width: min(100%, 720px);
    margin-inline: auto;
  }

  .prose {
    color: rgb(255 255 255 / 84%);
    font: 400 clamp(1rem, 2vw, 1.1rem)/1.85 system-ui, sans-serif;
  }

  .prose :global(a) {
    color: #c6b5ff;
    text-decoration-color: rgb(198 181 255 / 55%);
    text-underline-offset: 0.2em;
    transition: color 180ms ease, text-decoration-color 180ms ease;
  }

  .prose :global(a:hover),
  .prose :global(a:focus-visible) {
    color: #fff;
    text-decoration-color: currentColor;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin: 2.5rem 0 1rem;
    color: #fff;
    font-family: system-ui, sans-serif;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .prose :global(h2) {
    font-size: clamp(1.5rem, 4vw, 1.9rem);
  }

  .prose :global(h3) {
    font-size: 1.3rem;
  }

  .prose :global(p) {
    margin: 0 0 1.5rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    padding-left: 0.35rem;
    margin-bottom: 0.5rem;
  }

  .prose :global(li::marker) {
    color: #a588ff;
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 3px solid #a588ff;
    color: rgb(255 255 255 / 75%);
  }

  .prose :global(code) {
    padding: 0.18em 0.4em;
    border: 1px solid rgb(165 136 255 / 20%);
    border-radius: 0.35rem;
    background: var(--surface-raised);
    color: #d5c8ff;
    font: 500 0.88em/1.5 ui-monospace, SFMono-Regular, Consolas, monospace;
  }

  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem auto;
    border: 1px solid rgb(165 136 255 / 18%);
    border-radius: 1rem;
  }

  .prose :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid rgb(255 255 255 / 14%);
  }

  .category-badge {
    display: inline-flex;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgb(165 136 255 / 35%);
    border-radius: 999px;
    background: rgb(165 136 255 / 10%);
    color: #d5c8ff;
    font: 700 0.72rem/1.2 system-ui, sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-title {
    margin: 0 0 1rem;
    color: #fff;
    font: 700 clamp(1.4rem, 3vw, 1.8rem)/1.3 system-ui, sans-serif;
  }

  .video-section {
    margin-top: 3rem;
  }

  .video-responsive {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid rgb(165 136 255 / 22%);
    border-radius: 1rem;
    background: #000;
  }

  .video-responsive iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 480px) {
    .post-meta {
      flex-direction: column;
      gap: 0.5rem;
    }

    .image-wrapper {
      border-radius: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link,
    .prose :global(a) {
      transition: none;
    }
  }
</style>
---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import BlogPostCard from "../components/BlogPostCard.astro";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<SiteLayout
  title="Blog | MisterDatos"
  description="Artículos de MisterDatos sobre videojuegos, proyectos, música y más."
>
  <section class="blog-intro" aria-labelledby="blog-heading">
    <h1 id="blog-heading">El blog de MisterDatos</h1>
  </section>

  <div class="search-section">
    <div class="search-area">
      <div class="search-wrapper" role="search">
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.8" cy="10.8" r="6.8" />
          <path d="m16 16 4.2 4.2" />
        </svg>
        <label class="visually-hidden" for="blog-search">Buscar publicaciones</label>
        <input
          type="search"
          id="blog-search"
          placeholder="Ej. Pokémon, Zelda, Kirby..."
          autocomplete="off"
          aria-describedby="search-info"
          aria-controls="posts-container"
        />
      </div>
      <div id="search-info" class="search-info" aria-live="polite">
        Mostrando todas las publicaciones
      </div>
    </div>
  </div>

  <section class="posts-section" aria-label="Artículos del blog">
    <div class="blog-grid" id="posts-container">
    {
      sortedPosts.map((post) => (
        <BlogPostCard
          title={post.data.title}
          description={post.data.description ?? ""}
          date={post.data.date}
          url={`/blog/${post.slug}`}
          image={post.data.image}
          category={post.data.categories?.[0]}
          slug={post.slug}
        />
      ))
    }
      <div id="no-results" class="no-results" style="display: none;" role="status">
        <p>No se encontraron publicaciones con ese nombre 😅</p>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .blog-intro {
    width: min(100% - 2rem, 760px);
    margin-inline: auto;
    padding: clamp(2.75rem, 7vw, 5rem) 0 clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
  }

  .blog-intro h1 {
    color: #fff;
    font: 750 clamp(2rem, 5vw, 3.5rem)/1.12 var(--font-body);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .search-section {
    padding: 0 1rem;
    display: flex;
    justify-content: center;
  }

  .search-area {
    width: min(100%, 560px);
  }

  .search-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    border: 1px solid rgb(165 136 255 / 42%);
    border-radius: 999px;
    background: rgb(36 23 42 / 88%);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .search-wrapper:focus-within {
    border-color: #a588ff;
    box-shadow: 0 0 0 3px rgb(165 136 255 / 12%);
  }

  .search-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
    margin-left: 1.1rem;
    fill: none;
    stroke: #c6b5ff;
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  #blog-search {
    width: 100%;
    min-width: 0;
    min-height: 3.25rem;
    padding: 0.75rem 1rem;
    border: 0;
    outline: 0;
    background: transparent;
    color: #fff;
    font: 400 0.95rem/1.4 system-ui, sans-serif;
    -webkit-tap-highlight-color: transparent;
  }

  #blog-search::placeholder {
    color: rgb(255 255 255 / 48%);
  }

  #blog-search::-webkit-search-cancel-button {
    cursor: pointer;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
    border: 0;
  }

  .search-info {
    min-height: 1.25rem;
    margin-top: 0.65rem;
    padding-left: 1rem;
    color: rgb(255 255 255 / 58%);
    font: 400 0.78rem/1.5 system-ui, sans-serif;
  }

  .posts-section {
    width: min(100%, 1320px);
    margin-inline: auto;
    padding: clamp(1.75rem, 4vw, 2.5rem) 1rem 3rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .search-wrapper {
      transition: none;
    }
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 380px));
    justify-content: center;
    align-items: stretch;
    gap: clamp(1rem, 2vw, 1.5rem);
    box-sizing: border-box;
    min-height: 12rem;
  }

  .no-results {
    grid-column: 1 / -1;
    color: #ffffff;
    font-size: 1.2rem;
    padding: clamp(2rem, 5vw, 3rem);
    text-align: center;
  }

  @media (max-width: 480px) {
    .search-section {
      padding-inline: 1.25rem;
    }
  }
</style>

<script>
  const initSearch = () => {
    const searchInput = document.getElementById('blog-search') as HTMLInputElement;
    const posts = document.querySelectorAll('.blog-card');
    const infoText = document.getElementById('search-info');
    const noResults = document.getElementById('no-results');

    if (!searchInput) return;

    searchInput.addEventListener('input', () => {
      const normalize = (value: string) =>
        value
          .toLocaleLowerCase("es")
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "");
      const query = normalize(searchInput.value.trim());
      let foundCount = 0;

      posts.forEach((post) => {
        const title = normalize(post.getAttribute('data-title') || "");
        const desc = normalize(post.getAttribute('data-description') || "");

        if (title.includes(query) || desc.includes(query)) {
          (post as HTMLElement).style.display = 'block';
          foundCount++;
        } else {
          (post as HTMLElement).style.display = 'none';
        }
      });

      if (infoText) {
        infoText.textContent = query 
          ? `Resultados encontrados: ${foundCount}` 
          : "Mostrando todas las publicaciones";
      }

      if (noResults) {
        noResults.style.display = (foundCount === 0) ? 'block' : 'none';
      }
    });
  };

  initSearch();

  document.addEventListener('astro:after-swap', initSearch);
</script>